<?xml version="1.0" encoding="utf-8"?>
<!-- The play flavour's own entries: Google Play Games, Sidekick, and AdMob, which the github flavour has none of. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nearby Connections (netplay/NearbyConnections), by Android version: asked for at runtime when the player first
         hosts or joins a game, never at launch. Location only where older Androids need it to find nearby phones. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <!-- Not required: the Wi-Fi, Bluetooth and location permissions above would otherwise make Play require each, and keep
         the app from devices without them. Nearby uses whichever radios a phone has; netplay is the only use of any. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Backups and device transfers leave out Play Games' start-at-launch choice, which is this device's own, and up to
         Android 11, where adb can edit and restore a backup, everything but the settings: see res/xml/backup_rules.xml
         (up to Android 11) and data_extraction_rules.xml (from 12). -->
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31">

        <!-- AdMob's app id (build.gradle.kts, admobAppId): the SDK refuses to start without it. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- Play Games Sidekick's tab position and snooze; read by Play only for a bundle installed from Play. -->
        <meta-data
            android:name="com.google.android.finsky.deku.OVERLAY_CONFIG"
            android:resource="@xml/sidekick_config" />

        <!-- The Play Games SDK starts itself (and so signs in) at every launch through this provider. It's started by
             PlayGamesServices instead, only once the player has signed in from Settings. Disabled rather than removed:
             a removal warns in every merge without the SDK's manifest (the unit tests'), and this way the tests see it. -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            android:enabled="false"
            android:exported="false" />
    </application>

</manifest>
