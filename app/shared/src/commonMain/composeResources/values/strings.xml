<?xml version="1.0" encoding="utf-8"?>
<!--
    Every player-visible and spoken string in the shared UI, in British English (the base locale).
    Conventions - key names, positional arguments, plurals, what stays out of here - are in
    .claude/I18N.md. A translation goes in values-xx/strings.xml beside this file.

    Signs and units beside a number ("=2", "+100", "50%", "x3", "12s", "1.") are part of the translation: put each
    on the side, and with the spacing, the language reads it. In a right-to-left language the app is laid out right
    to left, and a sign that is first in the string is drawn on the right.
-->
<resources>

    <!--
        The language of this file, as a BCP 47 tag. Not shown: it's what numbers, dates, plural forms and the
        layout direction follow, so they always match the words around them - a French phone on an untranslated
        app gets English text and "1st", not English text and "1er", and an Arabic phone gets English laid out
        left to right. Every translation sets its own ("fr", "de", "ar-u-nu-arab"...). See .claude/I18N.md.
    -->
    <string name="common_locale">en-GB</string>

    <!--
        The BCP 47 tag whose style joins a list ("red, green, and blue"): its separators and last
        "and". Usually the same as common_locale. English uses en-US for the Oxford comma before the last item, which
        en-GB leaves out.
    -->
    <string name="common_list_locale">en-US</string>

    <!-- The app's name, passed as %1$s to the strings that mention it (about_*_body, common_crash_body, common_database_failure_body, licences_intro, rules_how_to_play_title, rules_modes_1) and drawn on the main menu. A brand name: every language keeps it. The launcher label is app/android's own app_name. -->
    <string name="app_name">Ludo Plus</string>

    <!--
        How a date and time is written ("28 Sep 2026 14:05"), as a CLDR date pattern: MMM is the short month name,
        d the day, yyyy the year, HH:mm the 24-hour time. Reorder it the way the language writes dates; the month
        names and digits follow common_locale.
    -->
    <string name="common_timestamp_pattern">d MMM yyyy HH:mm</string>

    <!--
        How two spoken clauses join, for a sentence whose pieces come and go ("Scored 12, would score
        15"); several are joined one pair at a time. Keep both arguments.
    -->
    <string name="common_clauses_join">%1$s, %2$s</string>
    <!-- How two spoken sentences join into running text. Keep both arguments. -->
    <string name="common_sentences_join">%1$s %2$s</string>

    <string name="player_colour_green">Green</string>
    <string name="player_colour_red">Red</string>
    <string name="player_colour_blue">Blue</string>

